t.toggle('hidden',i<0)}
function applyEdition(){const e=catalog.works[editingWork].editions[editingEdition];const oldId=e.id;e.id=$('eId').value.trim();e.format=$('eFormat').value;e.language=$('eLang').value.trim()||'unknown';e.sourceFileId=$('eSource').value.trim();e.fileName=$('eFile').value.trim();if(!e.id||!e.sourceFileId||!e.fileName)throw new Error('ID, sourceFileId e nome do arquivo são obrigatórios');if(oldId&&oldId!==e.id)media.delete(oldId);const url=$('eUrl').value.trim();if(url){const item={editionId:e.id,url};const size=$('eSize').value.trim();if(size)item.byteSize=Number(size);const etag=$('eEtag').value.trim();if(etag)item.etag=etag;const sha=$('eSha').value.trim();if(sha)item.sha256=sha;media.set(e.id,item)}else media.delete(e.id)}
function closeEdition(save=true){try{if(save)applyEdition();else if(!catalog.works[editingWork].editions[editingEdition]?.id)catalog.works[editingWork].editions.splice(editingEdition,1);$('editionEditor').classList.add('hidden');$('workEditor').classList.remove('hidden');renderEditions()}catch(e){alert(e.message)}}
function deleteEdition(){const e=catalog.works[editingWork].editions[editingEdition];if(!confirm('Excluir esta edição?'))return;if(e?.id)media.delete(e.id);catalog.works[editingWork].editions.splice(editingEdition,1);$('editionEditor').classList.add('hidden');$('workEditor').classList.remove('hidden');renderEditions()}
function deleteWork(){const w=catalog.works[editingWork];if(!confirm('Excluir esta obra e suas edições?'))return;for(const e of (w.editions||[]))media.delete(e.id);catalog.works.splice(editingWork,1);$('workEditor').classList.add('hidden');$('app').classList.remove('hidden');render()}
async function saveAll(){try{status('Validando e publicando…');const ids=new Set(),eids=new Set();for(const w of catalog.works){if(!w.id||ids.has(w.id))throw new Error('ID de obra ausente ou duplicado: '+w.id);ids.add(w.id);for(const e of (w.editions||[])){if(!e.id||eids.has(e.id))throw new Error('ID de edição ausente ou duplicado: '+e.id);eids.add(e.id)}}const next={revision:Number(catalog.revision||0)+1,works:catalog.works,tombstones:catalog.tombstones||[]};await api('/v1/admin/catalog',{method:'POST',body:next});const entries=[...media.values()];if(entries.length)await api('/v1/admin/media',{method:'POST',body:{entries}});for(const id of originalMediaIds){if(!media.has(id))await api('/v1/admin/media/'+encodeURIComponent(id),{method:'DELETE'})}catalog.revision=next.revision;originalMediaIds=new Set(media.keys());render();status('Publicado com sucesso na revisão '+catalog.revision+'.')}catch(e){status(e.message,true)}}
$('loginBtn').onclick=login;$('pass').onkeydown=e=>{if(e.key==='Enter')login()};$('reloadBtn').onclick=loadAll;$('addWorkBtn').onclick=()=>openWork(-1);$('saveBtn').onclick=saveAll;$('logoutBtn').onclick=()=>{token='';location.reload()};$('filter').oninput=render;$('addEditionBtn').onclick=()=>openEdition(-1);$('workOkBtn').onclick=()=>closeWork(true);$('workCancelBtn').onclick=()=>closeWork(false);$('workDeleteBtn').onclick=deleteWork;$('editionOkBtn').onclick=()=>closeEdition(true);$('editionCancelBtn').onclick=()=>closeEdition(false);$('editionDeleteBtn').onclick=deleteEdition;
</script>
</main>
</body></html>
