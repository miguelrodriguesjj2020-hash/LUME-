ton><button id="editionDeleteBtn" class="danger right">Excluir edição</button></div>
</section>
<script>
'use strict';
const $=id=>document.getElementById(id);let token='';let catalog={revision:0,works:[],tombstones:[]};let media=new Map();let originalMediaIds=new Set();let editingWork=-1,editingEdition=-1;
function status(msg,bad=false,target='status'){const e=$(target);e.textContent=msg;e.className='status '+(bad?'bad':'ok')}
async function api(path,opt={}){const headers={...(opt.headers||{})};if(token)headers.authorization='Bearer '+token;if(opt.body&&typeof opt.body!=='string'){headers['content-type']='application/json';opt.body=JSON.stringify(opt.body)}const r=await fetch(path,{...opt,headers});let j=null;try{j=await r.json()}catch{}if(!r.ok)throw new Error((j&&j.error)||('HTTP '+r.status));return j}
function clone(x){return JSON.parse(JSON.stringify(x))}
async function login(){try{status('Entrando…',false,'loginStatus');const j=await api('/v1/auth/login',{method:'POST',body:{username:$('user').value.trim(),password:$('pass').value}});if(j.role!=='admin')throw new Error('Esta conta não possui perfil administrativo');token=j.token;$('who').textContent=j.profileId+' · admin';$('loginCard').classList.add('hidden');$('app').classList.remove('hidden');await loadAll()}catch(e){status(e.message,true,'loginStatus')}}
async function loadAll(){try{status('Carregando catálogo…');const [c,m]=await Promise.all([api('/v1/bootstrap?since=0'),api('/v1/admin/media')]);catalog=c||{revision:0,works:[],tombstones:[]};catalog.works=Array.isArray(catalog.works)?catalog.works:[];catalog.tombstones=Array.isArray(catalog.tombstones)?catalog.tombstones:[];media=new Map((m.entries||[]).map(x=>[x.editionId,x]));originalMediaIds=new Set(media.keys());render();status('Catálogo carregado.')}catch(e){status(e.message,true)}}
function render(){const q=$('filter').value.trim().toLowerCase();$('revision').textContent='Revisão '+catalog.revision;const host=$('works');host.textContent='';const visible=catalog.works.map((w,i)=>[w,i]).filter(([w])=>!q||String(w.displayTitle||w.canonicalTitle||'').toLowerCase().includes(q));if(!visible.length){const d=document.createElement('div');d.className='empty';d.textContent='Nenhuma obra encontrada.';host.appendChild(d)}for(const [w,i] of visible){const box=document.createElement('div');box.className='work';const h=document.createElement('div');h.className='workhead';const a=document.createElement('div');const title=document.createElement('strong');title.textContent=w.displayTitle||w.canonicalTitle||w.id;const meta=document.createElement('div');meta.className='meta';meta.textContent=`${w.type} · ${(w.editions||[]).length} edição(ões) · ${w.id}`;a.append(title,meta);const b=document.createElement('button');b.className='ghost';b.textContent='Editar';b.onclick=()=>openWork(i);h.append(a,b);box.append(h);for(const s of (w.sections||w.editorialSections||[])){const t=document.createElement('span');t.className='tag';t.textContent=s;box.appendChild(t)}host.appendChild(box)}const editions=catalog.works.reduce((n,w)=>n+(w.editions||[]).length,0);$('summary').textContent=`${catalog.works.length} obra(s) · ${editions} edição(ões) · ${media.size} mídia(s) registrada(s)`}
function openWork(i){editingWork=i;const w=i<0?{id:'',displayTitle:'',type:'book',sections:[],editions:[]}:clone(catalog.works[i]);if(i<0){catalog.works.push(w);editingWork=catalog.works.length-1}$('wId').value=w.id||'';$('wTitle').value=w.displayTitle||w.canonicalTitle||'';$('wType').value=w.type||'book';$('wSections').value=(w.sections||w.editorialSections||[]).join(', ');$('workEditorTitle').textContent=i<0?'Nova obra':'Editar obra';$('workDeleteBtn').classList.toggle('hidden',i<0);$('app').classList.add('hidden');$('workEditor').classList.remove('hidden');renderEditions()}
function applyWorkFields(){const w=catalog.works[editingWork];w.id=$('wId').value.trim();w.displayTitle=$('wTitle').value.trim();w.canonicalTitle=w.canonicalTitle||w.displayTitle;w.type=$('wType').value;w.sections=$('wSections').value.split(',').map(x=>x.trim()).filter(Boolean);w.editions=Array.isArray(w.editions)?w.editions:[];if(!w.id||!w.displayTitle)throw new Error('ID e título são obrigatórios')}
function closeWork(save=true){try{if(save)applyWorkFields();else if(!$('wId').value.trim()&&!catalog.works[editingWork]?.id)catalog.works.splice(editingWork,1);$('workEditor').classList.add('hidden');$('app').classList.remove('hidden');render()}catch(e){status(e.message,true,'status')}}
function renderEditions(){const h=$('editions');h.textContent='';const list=catalog.works[editingWork].editions||[];if(!list.length){const d=document.createElement('div');d.className='empty';d.textContent='Sem edições.';h.appendChild(d)}list.forEach((e,i)=>{const row=document.createElement('div');row.className='edition';const a=document.createElement('strong');a.textContent=e.fileName||e.id;const m=document.createElement('span');m.className='meta';m.textContent=`${e.format||''} · ${e.language||'unknown'} · ${media.has(e.id)?'mídia OK':'sem mídia'}`;const b=document.createElement('button');b.className='ghost';b.textContent='Editar';b.onclick=()=>openEdition(i);row.append(a,m,b);h.appendChild(row)})}
function openEdition(i){try{applyWorkFields()}catch(e){alert(e.message);return}editingEdition=i;const e=i<0?{id:'',format:'pdf',language:'unknown',sourceFileId:'',fileName:''}:clone(catalog.works[editingWork].editions[i]);if(i<0){catalog.works[editingWork].editions.push(e);editingEdition=catalog.works[editingWork].editions.length-1}const m=media.get(e.id)||{};$('eId').value=e.id||'';$('eFormat').value=e.format||'pdf';$('eLang').value=e.language||'unknown';$('eSource').value=e.sourceFileId||'';$('eFile').value=e.fileName||'';$('eUrl').value=m.url||'';$('eSize').value=m.byteSize??'';$('eEtag').value=m.etag||'';$('eSha').value=m.sha256||'';$('workEditor').classList.add('hidden');$('editionEditor').classList.remove('hidden');$('editionDeleteBtn').classLis